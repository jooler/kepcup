# KepCup — 发行凭据示例（docs/dev/06-release.md）
#
# 用法：复制为仓库根目录的 `.env.release`（已被 .gitignore 忽略，**绝不要提交**），填入真实值。
#   cp .env.release.example .env.release && chmod 600 .env.release
#
# 三个脚本读它：
#   node scripts/release/sync-github-secrets.mjs   把「CI」段同步成 GitHub Actions 机密/变量（填完或改动后跑一次）
#   node scripts/release/store-upload.mjs          每次发版后本地提交 Microsoft Store（读「本地」段）
#   node scripts/release/sync-mirrors.mjs          发版后把资产同步到更新镜像（读「CI · 更新镜像」段；CI 也用它）
# 留空的项会被跳过：没填 Apple 凭据 → macOS 产物不签名；没填商店身份 → 不产出 MSIX。
# 证书/密钥文件建议放在仓库外（如 ~/.kepcup-release/），下面填路径；~ 会展开为家目录。

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------
# 发布仓库（必须公开：用户端 electron-updater 匿名读 Releases）。gh 先 `gh auth login`，不需要在这里放 token。
GH_REPO=jooler/kepcup

# ---------------------------------------------------------------------------
# CI · macOS 签名 + 公证（Apple Developer Program，个人身份即可）
# ---------------------------------------------------------------------------
# 「Developer ID Application」证书导出的 .p12（钥匙串访问 → 我的证书 → 右键导出，含私钥）。
# 注意不是「Apple Development」或「Apple Distribution」。→ 机密 MAC_CSC_LINK（base64）
MAC_CSC_P12_PATH=
# 导出 .p12 时设的密码。→ 机密 MAC_CSC_KEY_PASSWORD
MAC_CSC_KEY_PASSWORD=

# 公证用 App Store Connect API 密钥（App Store Connect → 用户和访问 → 集成 → 团队密钥，
# 角色选「开发者」即可）。.p8 只能下载一次，妥善保存。三项要么全填，要么全空。
# .p8 文件路径 → 机密 APPLE_API_KEY_BASE64
APPLE_API_KEY_P8_PATH=
# 密钥 ID（10 位，如 ABCDE12345）→ 机密 APPLE_API_KEY_ID
APPLE_API_KEY_ID=
# Issuer ID（页面顶部的 UUID）→ 机密 APPLE_API_ISSUER
APPLE_API_ISSUER=

# ---------------------------------------------------------------------------
# CI · Windows 代码签名（可选，先留空）
# ---------------------------------------------------------------------------
# 只影响 GitHub 直接下载的 NSIS 安装包（未签名 → SmartScreen「已保护你的电脑」提示）。
# 商店 MSIX 不需要：商店会重签。个人开发者可选项见文档「Windows 签名」。
WIN_CSC_P12_PATH=
WIN_CSC_KEY_PASSWORD=

# ---------------------------------------------------------------------------
# CI · 打进产物的 OAuth 客户端（可选；apps/desktop/scripts/dist.mjs 读取）
# ---------------------------------------------------------------------------
# 本地打包读仓库根 .env；这里留空时同步脚本会回退读 .env 里的同名项。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# CI · Microsoft Store 产品标识（公开信息 → GitHub Actions「变量」，不是机密）
# ---------------------------------------------------------------------------
# Partner Center → 应用 → 产品管理 → 产品标识（Product identity）页面，原样复制：
# Package/Identity/Name，如 12345YourName.KepCup
MSSTORE_IDENTITY_NAME=
# Package/Identity/Publisher，如 CN=1A2B3C4D-....（含 CN= 前缀）
MSSTORE_PUBLISHER=
# Package/Properties/PublisherDisplayName，你的开发者显示名
MSSTORE_PUBLISHER_DISPLAY_NAME=

# ---------------------------------------------------------------------------
# CI · 更新镜像（R2 + OSS，可选；scripts/release/sync-mirrors.mjs 读取）
# ---------------------------------------------------------------------------
# GitHub Releases 是唯一写入口；发布后 publish job 把资产同步到两个只读镜像：
#   R2 → 国际第二源（bucket 绑 updates.kepcup.com，流出免费）；
#   OSS → 国内首选（bucket 默认域名即可用，无需备案）。
# 每个镜像四项要么全填，要么全空；全空时 CI 的镜像同步步骤自动跳过。
# 客户端按实际可达性探测选源（github → r2 → oss），镜像内容不被信任（sha512 兜底）。
#
# R2：Cloudflare dashboard → R2 → Manage R2 API Tokens → Create API Token
#     （Object Read & Write，限定到该 bucket）生成的 S3 凭据。
# Account ID（32 位十六进制，与 .env 里 CLOUDFLARE_ACCOUNT_ID 同值）→ 机密 R2_ACCOUNT_ID
R2_ACCOUNT_ID=
# S3 访问密钥 ID → 机密 R2_ACCESS_KEY_ID
R2_ACCESS_KEY_ID=
# S3 秘密访问密钥 → 机密 R2_SECRET_ACCESS_KEY
R2_SECRET_ACCESS_KEY=
# bucket 名（如 kepcup-updates）→ 机密 R2_BUCKET
R2_BUCKET=
#
# OSS：RAM 访问控制 → 创建 RAM 子账号，只授予该 bucket 的读写权限
#     （acs:oss:*:*:<bucket> 与 acs:oss:*:*:<bucket>/*）。
# AccessKey ID → 机密 OSS_ACCESS_KEY_ID
OSS_ACCESS_KEY_ID=
# AccessKey Secret → 机密 OSS_SECRET_ACCESS_KEY
OSS_SECRET_ACCESS_KEY=
# bucket 名（如 kepcup-updates，公共读）→ 机密 OSS_BUCKET
OSS_BUCKET=
# 不带 bucket 前缀的 Endpoint，如 oss-cn-hangzhou.aliyuncs.com → 机密 OSS_ENDPOINT
OSS_ENDPOINT=

# ---------------------------------------------------------------------------
# 本地 · Microsoft Store 提交 API（只在本机用，不同步到 GitHub）
# ---------------------------------------------------------------------------
# 前提：Partner Center → 账户设置 → 租户 关联一个 Entra ID 租户（可在页面内免费新建），
# 用户管理 → Microsoft Entra 应用程序 添加一个应用并给「Manager」角色，再为它生成客户端密钥。
# 应用的首次提交必须在 Partner Center 手工完成（含年龄分级），之后才能用 API 更新。
# 目录（租户）ID
MSSTORE_TENANT_ID=
# 卖家 ID（账户设置 → 法律信息 → 开发人员 页面的 Seller ID）
MSSTORE_SELLER_ID=
# Entra 应用的客户端（应用程序）ID
MSSTORE_CLIENT_ID=
# 客户端密钥（有过期时间，过期后 store-upload 会报鉴权失败，到 Partner Center 重新生成）
MSSTORE_CLIENT_SECRET=
# 商店产品 ID（Store ID，如 9NXXXXXXXXXX）
MSSTORE_PRODUCT_ID=
