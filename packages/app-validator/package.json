{
  "name": "@kepcup/app-validator",
  "version": "0.0.0",
  "private": true,
  "description": "kepcup-app: validate a KepCup connector manifest (server.json) and its remote MCP server",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kepcup-app": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-tests.mjs run --project app-validator"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-mcp": "1.0.2",
    "@kepcup/shared": "workspace:*"
  }
}
