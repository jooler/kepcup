{
  "name": "com.notion/mcp",
  "title": "Notion",
  "description": "搜索、阅读与编辑 Notion 页面和数据库",
  "version": "1.0.3",
  "websiteUrl": "https://www.notion.so",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.notion.com/mcp"
    }
  ],
  "_meta": {
    "app.kepcup/connector": {
      "slug": "notion",
      "icon": "notion.svg",
      "category": "productivity",
      "tier": "community",
      "auth": {
        "kind": "oauth",
        "registration": "auto",
        "clientRef": null,
        "scopes": {
          "default": [],
          "write": []
        }
      },
      "toolPolicy": {
        "notion-create-comment": {
          "risk": "destructive"
        }
      },
      "whoami": {
        "tool": "notion-get-self",
        "labelPath": "workspace.name",
        "subjectPath": "workspace.id"
      },
      "skills": [],
      "ui": false,
      "privacyPolicy": "https://www.notion.so/privacy"
    }
  }
}
