{
  "manifest_version": "0.3",
  "name": "yuque-mcp",
  "display_name": "语雀",
  "version": "1.0.0",
  "description": "语雀官方 MCP server（github.com/yuque/yuque-mcp-server）：知识库与文档的创建、更新、目录维护。",
  "author": {
    "name": "Yuque"
  },
  "server": {
    "type": "node",
    "entry_point": "node_modules/yuque-mcp/dist/cli.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/node_modules/yuque-mcp/dist/cli.js"],
      "env": {
        "YUQUE_PERSONAL_TOKEN": "${user_config.token}",
        "YUQUE_BASE_URL": "${user_config.host}"
      }
    }
  },
  "user_config": {
    "token": {
      "type": "string",
      "title": "语雀 API Token",
      "description": "在 www.yuque.com/settings/tokens 创建；个人令牌需要语雀超级会员，空间版用户填团队 Token。",
      "required": true,
      "sensitive": true
    },
    "host": {
      "type": "string",
      "title": "站点 / 空间地址（选填）",
      "description": "空间版用户填空间域名（如 https://your-space.yuque.com），留空使用语雀主站。",
      "required": false
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "node": ">=18.0.0"
    }
  }
}
