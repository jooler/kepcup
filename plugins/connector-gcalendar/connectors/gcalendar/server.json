{
  "name": "com.google/calendar-mcp",
  "title": "Google Calendar",
  "description": "查看、搜索与安排 Google 日历日程",
  "version": "1.0.0",
  "websiteUrl": "https://calendar.google.com",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://calendarmcp.googleapis.com/mcp/v1"
    }
  ],
  "_meta": {
    "app.kepcup/connector": {
      "slug": "gcalendar",
      "icon": "gcalendar.svg",
      "category": "productivity",
      "tier": "community",
      "auth": {
        "kind": "oauth",
        "registration": "preregistered",
        "clientRef": "google",
        "scopes": {
          "default": ["https://www.googleapis.com/auth/calendar.events"],
          "write": []
        }
      },
      "toolPolicy": {},
      "skills": [],
      "ui": false,
      "privacyPolicy": "https://policies.google.com/privacy"
    }
  }
}
