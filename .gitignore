# WSL rootfs 产物：CI rootfs job 产出，本地 dist.mjs 自建（P12/P13），
# 仓库只保留 .gitkeep 与脚本。旧单文件布局（wsl/rootfs.*）一并覆盖。
apps/desktop/resources/wsl/*/rootfs.tar
apps/desktop/resources/wsl/*/rootfs-manifest.json
apps/desktop/resources/wsl/rootfs.*

# D94: Share Extension 的构建产物（xcodebuild 出 .appex + 解析出的 App Group
# 组 id）与展开后的 entitlements——都是打包期产物，不入库。
apps/desktop/resources/share-extension/
apps/desktop/resources/entitlements.mac.expanded.plist

# D105: computer-use helper 的 SwiftPM 构建中间产物与组包产物
# （build-computer-use-macos.mjs 生成，vendored 源码本身入库）。
apps/desktop/native/computer-use-macos/.build/
apps/desktop/resources/computer-use/
# P-B1: cua-driver provider 的 fetch 产物（scripts/fetch-cua-driver.mjs 下载
# 解包的 CuaDriver.app；版本 pin 入库在 resources/cua-driver.lock.json）。
apps/desktop/resources/cua-driver/
# 冒烟客户端必须以 out/main/computer-sidecar.js 的路径运行（helper 的 socket peer
# 校验按命令行路径识别 sidecar），与上方全局 out/ 产物忽略冲突——豁免这一个目录。
!apps/desktop/scripts/computer-use-smoke-client/out/

# ZCode session-local state (plans etc.) and its sync file
.zcode/
.zcodeignore

.apiresearch
.claude/worktrees/

# macOS
.DS_Store

# D96 WP5: renderer web 构建(PWA)的产物,由 `pnpm --filter @kepcup/desktop build:web`
# 生成到中转 Worker 的静态资产目录;public/ 里的占位 index.html 会被构建覆盖,
# README.md 与 verify.mjs 与构建无关,始终入库。
infra/cloudflare/relay/public/assets/
infra/cloudflare/relay/public/index.html
infra/cloudflare/relay/public/manifest.webmanifest
infra/cloudflare/relay/public/sw.js
infra/cloudflare/relay/public/icon.svg
infra/cloudflare/relay/public/icon-256.png
infra/cloudflare/relay/public/icon-512.png

# D96 WP6: wrangler dev 本地联调的运行时状态(workerd 持久化/临时构建产物)
infra/cloudflare/relay/.wrangler/

# D102 headless 服务端：web 构建产物（pack-server.mjs 生成）
apps/server/web/
release-server/
