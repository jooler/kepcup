---
import type { Copy } from '../i18n/types';
import { links } from '../i18n/links';

interface Props {
  copy: Copy;
  homePath: string;
  alternatePath: string;
}

const { copy, homePath, alternatePath } = Astro.props;
const downloadHref = `${homePath}#download`;
---

<div class="topbar"></div>
<a class="skip" href="#main">{copy.nav.skip}</a>
<header class="header">
  <div class="wrap header-inner">
    <a class="brand" href={homePath}>
      <img
        class="mark mark-light"
        src="/brand/logo-light.svg"
        width="34"
        height="26"
        alt=""
      />
      <img class="mark mark-dark" src="/brand/logo-dark.svg" width="34" height="26" alt="" />
      <span>KepCup</span>
    </a>
    <nav class="nav-links" aria-label={copy.nav.primary}>
      <a href={links.docs} rel="noopener noreferrer">{copy.nav.docs}</a>
      <a href={links.github} rel="noopener noreferrer">{copy.nav.github}</a>
      <a class="nav-download" href={downloadHref}>{copy.nav.download}</a>
      <a
        href={alternatePath}
        hreflang={copy.locale === 'en' ? 'zh-CN' : 'en'}
        lang={copy.locale === 'en' ? 'zh-CN' : 'en'}
      >
        {copy.nav.langName}
      </a>
    </nav>
  </div>
</header>
