---
import Base from '../layouts/Base.astro';
import Rich from './Rich.astro';
import type { Copy } from '../i18n/types';
import { links } from '../i18n/links';

interface Props {
  copy: Copy;
  homePath: string;
  alternatePath: string;
  privacyPath: string;
  termsPath: string;
}

const { copy, homePath, alternatePath, privacyPath, termsPath } = Astro.props;

const shotImages = {
  loop: { src: '/images/Chat.png', width: 1024, height: 727 },
  team: { src: '/images/Team_group.png', width: 1024, height: 727 },
  bench: { src: '/images/Workbench.png', width: 1024, height: 727 },
  wiki: { src: '/images/Bot-wiki.png', width: 972, height: 930 },
  extensions: { src: '/images/extensions.png', width: 2288, height: 1296 },
} as const;
---

<Base
  copy={copy}
  currentPath={homePath}
  alternatePath={alternatePath}
  homePath={homePath}
  privacyPath={privacyPath}
  termsPath={termsPath}
>
  <main id="main">
    <div class="wrap">
      <!-- Hero -->
      <section class="hero" aria-labelledby="slogan">
        <p class="eyebrow">{copy.hero.eyebrow}</p>
        <h1 id="slogan" class="hero-title">{copy.hero.title}</h1>
        <p class="hero-lede">{copy.hero.lede}</p>
        <div class="hero-actions">
          <a class="btn btn-dark btn-lg" href="#download">{copy.hero.primary}</a>
          <a class="btn btn-soft btn-lg" href={links.github} rel="noopener noreferrer">
            {copy.hero.secondary}
          </a>
        </div>
        <p class="hero-note">{copy.hero.note}</p>
        <img
          class="hero-shot"
          src="/images/Meet_KepCup.png"
          width="1024"
          height="726"
          loading="eager"
          decoding="async"
          alt={copy.hero.imageAlt}
        />
      </section>

      <!-- Band: the dual loop -->
      <section class="band" aria-labelledby="loop-title">
        <div class="band-grid">
          <div class="band-copy">
            <h2 id="loop-title">{copy.loopBand.title}</h2>
            <p class="band-body">{copy.loopBand.body}</p>
            <div class="band-points">
              {
                copy.loopBand.points.map((point) => (
                  <div class="band-point">
                    <h3>{point.title}</h3>
                    <p>{point.body}</p>
                  </div>
                ))
              }
            </div>
            <p class="band-caption">{copy.loopBand.caption}</p>
          </div>
          <figure class="band-media">
            <img
              src={shotImages.loop.src}
              width={shotImages.loop.width}
              height={shotImages.loop.height}
              loading="lazy"
              decoding="async"
              alt={copy.loopBand.imageAlt}
            />
          </figure>
        </div>
      </section>

      <!-- Crew: centered heading + 2x2 cards -->
      <section class="section" aria-labelledby="crew-title">
        <div class="section-head">
          <h2 id="crew-title">{copy.crew.title}</h2>
          <p class="section-lede">{copy.crew.lede}</p>
        </div>
        <div class="cards">
          {
            copy.crew.cards.map((card) => {
              const image = shotImages[card.image];
              return (
                <article class="card">
                  <h3>{card.title}</h3>
                  <p>{card.body}</p>
                  <div class="card-visual">
                    <img
                      src={image.src}
                      width={image.width}
                      height={image.height}
                      loading="lazy"
                      decoding="async"
                      alt={card.imageAlt}
                    />
                  </div>
                </article>
              );
            })
          }
        </div>
      </section>

      <!-- Band: local + your models -->
      <section class="band band-local" aria-labelledby="local-title">
        <div class="band-local-grid">
          <div class="band-copy">
            <h2 id="local-title">{copy.localBand.title}</h2>
            <p class="band-body">{copy.localBand.body}</p>
            <ul class="chips" role="list">
              {copy.localBand.chips.map((chip) => <li>{chip}</li>)}
            </ul>
          </div>
          <div class="band-points band-points--stack">
            {
              copy.localBand.points.map((point) => (
                <div class="band-point">
                  <h3>{point.title}</h3>
                  <p>{point.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- OpenMind -->
      <section class="section openmind" id="openmind" aria-labelledby="openmind-title">
        <p class="eyebrow">{copy.openMind.kicker}</p>
        <h2 id="openmind-title">{copy.openMind.title}</h2>
        <div class="prose">
          {
            copy.openMind.paragraphs.map((paragraph) => (
              <p>
                <Rich text={paragraph} />
              </p>
            ))
          }
        </div>
        <a class="btn btn-soft" href={links.docs} rel="noopener noreferrer">{copy.openMind.cta}</a>
      </section>

      <!-- Download -->
      <section class="section split" id="download" aria-labelledby="download-title">
        <div class="split-copy">
          <h2 id="download-title">{copy.download.title}</h2>
          <p class="split-lede">{copy.download.lede}</p>
        </div>
        <div class="dl-list">
          {
            copy.download.platforms.map((platform) => (
              <a class="dl-card" href={platform.href} rel="noopener noreferrer">
                <span class="dl-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path
                      d="M8 2v9m0 0L4.5 7.5M8 11l3.5-3.5M3 14h10"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
                  </svg>
                </span>
                <span class="dl-text">
                  <strong>{platform.name}</strong>
                  <span>{platform.sub}</span>
                </span>
              </a>
            ))
          }
          <a class="dl-card" href={copy.download.more.href} rel="noopener noreferrer">
            <span class="dl-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path
                  d="M5.5 5 2.5 8l3 3m5-6 3 3-3 3"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round" />
              </svg>
            </span>
            <span class="dl-text">
              <strong>{copy.download.more.name}</strong>
              <span>{copy.download.more.sub}</span>
            </span>
          </a>
        </div>
      </section>

      <!-- FAQ -->
      <section class="section split" id="faq" aria-labelledby="faq-title">
        <div class="split-copy">
          <h2 id="faq-title">{copy.faq.title}</h2>
        </div>
        <div class="faq-list">
          {
            copy.faq.items.map((item) => (
              <details class="faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <!-- Final CTA -->
      <section class="cta" aria-labelledby="cta-title">
        <div class="cta-mark" aria-hidden="true">
          <svg viewBox="56 100 400 311" fill="none">
            <path
              d="M 149 111 H 362 A 37 37 0 0 1 399 148 V 300 A 37 37 0 0 1 362 337 H 286 L 192 400 L 214 337 H 149 A 37 37 0 0 1 112 300 V 148 A 37 37 0 0 1 149 111 Z"
              stroke="currentColor"
              stroke-width="6"></path>
          </svg>
        </div>
        <h2 id="cta-title">{copy.cta.title}</h2>
        <p class="cta-lede">{copy.cta.lede}</p>
        <div class="hero-actions">
          <a class="btn btn-dark btn-lg" href="#download">{copy.cta.primary}</a>
          <a class="btn btn-soft btn-lg" href={links.docs} rel="noopener noreferrer">{copy.cta.secondary}</a>
        </div>
      </section>
    </div>
  </main>
</Base>
