{
  "name": "com.google/drive-mcp",
  "title": "Google Drive",
  "description": "搜索、读取与创建 Google Drive 文件（仅限授权给 KepCup 的文件）",
  "version": "1.0.0",
  "websiteUrl": "https://drive.google.com",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://drivemcp.googleapis.com/mcp/v1"
    }
  ],
  "_meta": {
    "app.kepcup/connector": {
      "slug": "gdrive",
      "icon": "gdrive.svg",
      "category": "productivity",
      "tier": "builtin",
      "auth": {
        "kind": "oauth",
        "registration": "preregistered",
        "clientRef": "google",
        "scopes": {
          "default": [
            "https://www.googleapis.com/auth/drive.file"
          ],
          "write": []
        }
      },
      "toolPolicy": {},
      "skills": [],
      "ui": false,
      "privacyPolicy": "https://policies.google.com/privacy",
      "releaseGate": "google",
      "hidden": true
    }
  }
}
