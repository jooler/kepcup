{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "electron.vite.config.ts",
    "vite.config.web.ts",
    "playwright.config.ts",
    "playwright.web.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/core-entry/**/*",
    "test/e2e/**/*",
    "test/web/**/*"
  ]
}
