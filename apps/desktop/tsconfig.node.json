{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      // T8: the driver's exports map lacks a "types" condition (same mapping as
      // packages/core) — point tsc at the shipped declarations directly.
      "better-sqlite3-multiple-ciphers": ["node_modules/better-sqlite3-multiple-ciphers/index.d.ts"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "vite.config.web.ts",
    "playwright.config.ts",
    "playwright.web.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/core-entry/**/*",
    "test/e2e/**/*",
    "test/web/**/*"
  ]
}
