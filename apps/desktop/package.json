{
  "name": "@kepcup/desktop",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "description": "KepCup —— 本地优先的 Bot 运行时桌面应用：创建并调度拥有独立人格、记忆与能力的 AI 联系人，数据全部保存在本地。",
  "homepage": "https://kepcup.app",
  "author": {
    "name": "kepcup-app",
    "email": "kepcup-app@kepcup.app"
  },
  "license": "GPL-3.0",
  "scripts": {
    "dev": "node scripts/patch-dev-electron.cjs && electron-vite dev",
    "icons": "node scripts/generate-icons.mjs",
    "build": "electron-vite build",
    "build:web": "vite build -c vite.config.web.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && svelte-check --tsconfig tsconfig.web.json",
    "test:e2e": "playwright test",
    "test:web": "vite build -c vite.config.web.ts && playwright test -c playwright.web.config.ts",
    "dist": "node scripts/dist.mjs"
  },
  "dependencies": {
    "@humanspeak/svelte-virtual-list": "0.5.15",
    "@kepcup/core": "workspace:*",
    "@kepcup/shared": "workspace:*",
    "@lucide/svelte": "1.74.0",
    "@pierre/diffs": "1.6.4",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-document": "^3.34.0",
    "@tiptap/extension-hard-break": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-mention": "^3.34.0",
    "@tiptap/extension-paragraph": "^3.34.0",
    "@tiptap/extension-text": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/markdown": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "bits-ui": "2.21.0",
    "clsx": "2.1.1",
    "electron-updater": "6.8.11",
    "jsqr": "1.4.0",
    "mammoth": "1.13.0",
    "mode-watcher": "1.1.0",
    "streamdown-svelte": "3.0.6",
    "svelte-sonner": "1.2.3",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0",
    "uqr": "^0.1.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@internationalized/date": "3.12.4",
    "@kepcup/testkit": "workspace:*",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.5",
    "csstype": "3.2.4",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.2",
    "paneforge": "1.0.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "vite": "7.3.6",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@11.22.0"
}
