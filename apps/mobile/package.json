{
  "name": "@kepcup/mobile",
  "version": "0.5.10",
  "private": true,
  "type": "module",
  "description": "KepCup 手机原生壳(D122):原生首页(扫码 / 地址输入 / 最近连接)+ WebView 加载所连服务端托管的 web 客户端。设计见 docs/design/58-mobile-shell.md。",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "icons": "node scripts/generate-icons.mjs",
    "sync": "vite build && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.app.json --noEmit && svelte-check --tsconfig tsconfig.app.json",
    "test": "node ../../scripts/run-tests.mjs run --project mobile --project mobile-svelte"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@kepcup/shared": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "vite": "7.3.6"
  }
}
