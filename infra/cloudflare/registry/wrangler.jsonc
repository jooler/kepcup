{
  // KepCup MCP 子注册表（设计 29 §11.4 / §15.2）：官方 Registry OpenAPI v0.1 的只读实现，
  // Workers + D1 + Cache API；Cron 从官方注册表增量同步。
  // 部署前必须由用户完成 README「用户待办」：创建 D1、替换下面的 database_id、DNS、迁移 schema。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kepcup-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kepcup-registry",
      // 2026-10-10 由 `cf d1 create --name kepcup-registry` 创建（WEUR）；这是资源标识，不是机密。
      "database_id": "efc7712f-a979-414e-b315-3640cd00a600",
    },
  ],
  "triggers": {
    // 每小时 17 分同步一次上游（避开整点拥塞）。
    "crons": ["17 * * * *"],
  },
  // custom domain：部署时 Cloudflare 自动创建 registry.kepcup.com 的 DNS 记录与证书。
  "routes": [{ "pattern": "registry.kepcup.com", "custom_domain": true }],
  "vars": {
    // Workers Free: 8 pages fit the 50-subrequest limit; raise on Workers Paid (see README).
    "SYNC_MAX_PAGES": "8",
    "UPSTREAM_REGISTRY_URL": "https://registry.modelcontextprotocol.io",
    "BUILD_VERSION": "0.1.0",
  },
}
