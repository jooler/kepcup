{
  "name": "kepcup",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @kepcup/shared run build && pnpm --filter @kepcup/core run build && pnpm --filter @kepcup/desktop dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "pnpm --filter @kepcup/shared run build && pnpm --filter @kepcup/core run build && pnpm -r typecheck",
    "test": "node scripts/run-tests.mjs run",
    "test:watch": "node scripts/run-tests.mjs",
    "test:e2e": "pnpm --filter @kepcup/desktop test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "electron": "44.4.5",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "16.4.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  }
}
